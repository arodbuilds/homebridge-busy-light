{
  "pluginAlias": "BusyLight",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "headerDisplay": "Busy Light turns a light red when you are busy and green when you are free. Add a calendar, then choose how the light is controlled. Not affiliated with or endorsed by Apple, Google, Microsoft or LIFX.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "description": "Starts the name of every sensor, for example \"Busy Light Available\".",
        "type": "string",
        "default": "Busy Light"
      },
      "calendars": {
        "title": "Calendars",
        "description": "Add the calendars that should make you busy. Busy Light combines them.",
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "type",
            "name"
          ],
          "properties": {
            "type": {
              "title": "Type",
              "type": "string",
              "oneOf": [
                {
                  "title": "iCloud",
                  "enum": [
                    "icloud"
                  ]
                },
                {
                  "title": "Google Calendar",
                  "enum": [
                    "google"
                  ]
                },
                {
                  "title": "Microsoft 365",
                  "enum": [
                    "microsoft"
                  ]
                },
                {
                  "title": "Calendar URL",
                  "enum": [
                    "url"
                  ]
                }
              ]
            },
            "name": {
              "title": "Name",
              "description": "A name for this calendar. It appears in the log.",
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,64}$"
            },
            "appleId": {
              "title": "Apple Account email",
              "type": "string"
            },
            "appPassword": {
              "title": "App-specific password",
              "description": "Create one at <a href=\"https://account.apple.com\" target=\"_blank\" rel=\"noopener noreferrer\">account.apple.com</a> under Sign-In and Security, then App-Specific Passwords (<a href=\"https://support.apple.com/en-us/102654\" target=\"_blank\" rel=\"noopener noreferrer\">how to</a>). This is not your Apple Account password.",
              "type": "string"
            },
            "calendars": {
              "title": "Calendars to include",
              "description": "Leave empty to use every calendar. The log lists the calendar names found.",
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "use": {
                        "type": "string",
                        "enum": [
                          "all",
                          "outOfOffice"
                        ],
                        "default": "all"
                      }
                    }
                  }
                ]
              }
            },
            "url": {
              "title": "Address",
              "description": "A calendar subscription link (often ending in .ics) that starts with https:// or webcal://.",
              "type": "string",
              "pattern": "^([Hh][Tt][Tt][Pp][Ss]|[Ww][Ee][Bb][Cc][Aa][Ll])://.+"
            },
            "email": {
              "title": "Your Google email",
              "description": "Optional. Lets Busy Light ignore invitations you declined.",
              "type": "string"
            },
            "tenantId": {
              "title": "Directory (tenant) ID",
              "description": "From your Microsoft 365 administrator.",
              "type": "string",
              "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
            },
            "clientId": {
              "title": "Application (client) ID",
              "description": "From your Microsoft 365 administrator.",
              "type": "string",
              "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
            },
            "useTeamsStatus": {
              "title": "Use Teams status",
              "type": "boolean",
              "default": true
            },
            "useCalendar": {
              "title": "Use Outlook calendar",
              "type": "boolean",
              "default": true
            },
            "use": {
              "title": "Counts for",
              "type": "string",
              "oneOf": [
                {
                  "title": "Busy and out of office",
                  "enum": [
                    "all"
                  ]
                },
                {
                  "title": "Out of office only",
                  "enum": [
                    "outOfOffice"
                  ]
                }
              ],
              "default": "all"
            },
            "calendarSeconds": {
              "title": "Check for changes every (seconds)",
              "type": "integer",
              "minimum": 60,
              "maximum": 600
            }
          }
        }
      },
      "colors": {
        "title": "Colors",
        "description": "A color such as #FF0000, or the word off to turn the light off for that status.",
        "type": "object",
        "properties": {
          "outOfOffice": {
            "title": "Out of office",
            "type": "string",
            "default": "#B400FF",
            "pattern": "^(#[0-9A-Fa-f]{6}|[Oo][Ff][Ff])$"
          },
          "doNotDisturb": {
            "title": "Do not disturb",
            "type": "string",
            "default": "#FF0000",
            "pattern": "^(#[0-9A-Fa-f]{6}|[Oo][Ff][Ff])$"
          },
          "inCall": {
            "title": "In a call",
            "type": "string",
            "default": "#FF0000",
            "pattern": "^(#[0-9A-Fa-f]{6}|[Oo][Ff][Ff])$"
          },
          "inMeeting": {
            "title": "In a meeting",
            "type": "string",
            "default": "#FF0000",
            "pattern": "^(#[0-9A-Fa-f]{6}|[Oo][Ff][Ff])$"
          },
          "busy": {
            "title": "Busy",
            "type": "string",
            "default": "#FF6A00",
            "pattern": "^(#[0-9A-Fa-f]{6}|[Oo][Ff][Ff])$"
          },
          "tentative": {
            "title": "Tentative",
            "type": "string",
            "default": "#FFD000",
            "pattern": "^(#[0-9A-Fa-f]{6}|[Oo][Ff][Ff])$"
          },
          "away": {
            "title": "Away",
            "type": "string",
            "default": "#FFD000",
            "pattern": "^(#[0-9A-Fa-f]{6}|[Oo][Ff][Ff])$"
          },
          "available": {
            "title": "Available",
            "type": "string",
            "default": "#00FF00",
            "pattern": "^(#[0-9A-Fa-f]{6}|[Oo][Ff][Ff])$"
          },
          "offline": {
            "title": "Offline",
            "type": "string",
            "default": "off",
            "pattern": "^(#[0-9A-Fa-f]{6}|[Oo][Ff][Ff])$"
          }
        }
      },
      "lifx": {
        "title": "LIFX bulbs",
        "type": "object",
        "properties": {
          "enabled": {
            "title": "Set a LIFX bulb directly",
            "type": "boolean",
            "default": false
          },
          "bulbs": {
            "title": "Bulbs",
            "description": "Leave empty if you have one LIFX bulb: it is found automatically. With several, add the name of each bulb to use, from the LIFX app. The log lists the bulbs found.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "host": {
            "title": "Bulb IP address",
            "description": "Only needed when the search cannot reach the bulbs, for example when Homebridge runs in Docker without host networking. Separate several addresses with commas.",
            "type": "string"
          },
          "brightness": {
            "title": "Brightness (percent)",
            "type": "integer",
            "default": 100,
            "minimum": 1,
            "maximum": 100
          },
          "refreshSeconds": {
            "title": "Send the color again every (seconds)",
            "description": "Recovers a bulb that was switched off at the wall. 0 sends only when the status changes.",
            "type": "integer",
            "default": 300,
            "minimum": 0,
            "maximum": 86400
          }
        }
      },
      "sensors": {
        "title": "Sensors to create",
        "description": "Each is an occupancy sensor in the Home app that is on while that is your status. Use them in automations to set any other light.",
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "enum": [
            "available",
            "busyAny",
            "outOfOffice",
            "inMeeting",
            "inCall",
            "doNotDisturb",
            "busy",
            "tentative",
            "away",
            "offline",
            "meetingSoon"
          ]
        },
        "default": [
          "available",
          "busyAny",
          "outOfOffice"
        ]
      },
      "overrideSwitch": {
        "title": "Override switch",
        "description": "Adds a switch to the Home app that forces Do not disturb while it is on.",
        "type": "boolean",
        "default": false
      },
      "pollSeconds": {
        "title": "Check status every (seconds)",
        "type": "integer",
        "default": 30,
        "minimum": 15,
        "maximum": 240
      },
      "calendarSeconds": {
        "title": "Reload calendars every (seconds)",
        "type": "integer",
        "default": 180,
        "minimum": 60,
        "maximum": 600
      },
      "ignoreAllDayBusy": {
        "title": "Ignore all-day events marked busy",
        "description": "All-day out of office events always count.",
        "type": "boolean",
        "default": true
      },
      "outOfOfficeWords": {
        "title": "Out of office words",
        "description": "iCloud, Google and URL calendar events with one of these words in the title count as out of office.",
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [
          "Out of office",
          "OOO",
          "Vacation",
          "PTO"
        ]
      },
      "debug": {
        "title": "Debug logging",
        "type": "boolean",
        "default": false
      },
      "statusInput": {
        "title": "Status from other apps",
        "type": "object",
        "properties": {
          "enabled": {
            "title": "Let other apps set your status",
            "type": "boolean",
            "default": false
          },
          "port": {
            "title": "Port",
            "type": "integer",
            "default": 8582,
            "minimum": 1024,
            "maximum": 65535
          },
          "key": {
            "title": "Key",
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{32,128}$"
          },
          "allowPlainKey": {
            "title": "Allow the plain key",
            "type": "boolean",
            "default": true
          }
        }
      },
      "callSwitch": {
        "title": "On a Call switch",
        "type": "object",
        "properties": {
          "enabled": {
            "title": "Add an On a Call switch to the Home app",
            "description": "Turn it on from a shortcut, Siri or a Home tile while you are on a call. No app needed.",
            "type": "boolean",
            "default": false
          },
          "hours": {
            "title": "Turn off automatically after (hours)",
            "type": "integer",
            "default": 3,
            "minimum": 1,
            "maximum": 12
          }
        }
      },
      "workingSwitch": {
        "title": "Working switch",
        "type": "object",
        "properties": {
          "enabled": {
            "title": "Add a Working switch to the Home app",
            "description": "Turn it off at the end of the day, for example in a Home scene, and the light stays off whatever your calendars say. Turn it on when you start work.",
            "type": "boolean",
            "default": false
          }
        }
      },
      "meetingWarningSeconds": {
        "title": "Warn before meetings",
        "description": "The light fades from the Available color to the In a meeting color before a meeting starts.",
        "type": "integer",
        "default": 0,
        "oneOf": [
          {
            "title": "Off",
            "enum": [
              0
            ]
          },
          {
            "title": "1 minute",
            "enum": [
              60
            ]
          },
          {
            "title": "2 minutes",
            "enum": [
              120
            ]
          },
          {
            "title": "3 minutes",
            "enum": [
              180
            ]
          },
          {
            "title": "5 minutes",
            "enum": [
              300
            ]
          }
        ]
      }
    }
  },
  "layout": [
    "name",
    {
      "key": "calendars",
      "type": "array",
      "title": "Calendars",
      "description": "Add the calendars that should make you busy. Busy Light combines them.",
      "items": [
        "calendars[].type",
        "calendars[].name",
        {
          "key": "calendars[].appleId",
          "condition": {
            "functionBody": "return model.calendars[arrayIndices].type === 'icloud';"
          }
        },
        {
          "key": "calendars[].appPassword",
          "condition": {
            "functionBody": "return model.calendars[arrayIndices].type === 'icloud';"
          }
        },
        {
          "key": "calendars[].calendars",
          "condition": {
            "functionBody": "return model.calendars[arrayIndices].type === 'icloud';"
          },
          "type": "array",
          "items": [
            "calendars[].calendars[]"
          ],
          "orderable": false
        },
        {
          "key": "calendars[].url",
          "title": "Secret address in iCal format",
          "description": "In Google Calendar settings, pick the calendar, then Integrate calendar. Treat it like a password.",
          "condition": {
            "functionBody": "return model.calendars[arrayIndices].type === 'google';"
          }
        },
        {
          "key": "calendars[].email",
          "condition": {
            "functionBody": "return model.calendars[arrayIndices].type === 'google';"
          }
        },
        {
          "key": "calendars[].url",
          "title": "Address",
          "description": "A calendar subscription link (often ending in .ics) that starts with https:// or webcal://.",
          "condition": {
            "functionBody": "return model.calendars[arrayIndices].type === 'url';"
          }
        },
        {
          "key": "calendars[].use",
          "condition": {
            "functionBody": "return ['google', 'url'].includes(model.calendars[arrayIndices].type);"
          }
        },
        {
          "key": "calendars[].tenantId",
          "condition": {
            "functionBody": "return model.calendars[arrayIndices].type === 'microsoft';"
          }
        },
        {
          "key": "calendars[].clientId",
          "condition": {
            "functionBody": "return model.calendars[arrayIndices].type === 'microsoft';"
          }
        },
        {
          "key": "calendars[].useTeamsStatus",
          "condition": {
            "functionBody": "return model.calendars[arrayIndices].type === 'microsoft';"
          }
        },
        {
          "key": "calendars[].useCalendar",
          "condition": {
            "functionBody": "return model.calendars[arrayIndices].type === 'microsoft';"
          }
        },
        "calendars[].calendarSeconds"
      ],
      "orderable": false
    },
    {
      "type": "fieldset",
      "title": "Status from other apps",
      "items": [
        "statusInput.enabled",
        {
          "key": "statusInput.port",
          "condition": {
            "functionBody": "return !!model.statusInput && model.statusInput.enabled === true;"
          }
        },
        {
          "key": "statusInput.key",
          "condition": {
            "functionBody": "return !!model.statusInput && model.statusInput.enabled === true;"
          }
        },
        {
          "key": "statusInput.allowPlainKey",
          "condition": {
            "functionBody": "return !!model.statusInput && model.statusInput.enabled === true;"
          }
        }
      ]
    },
    {
      "type": "fieldset",
      "title": "On a Call switch",
      "items": [
        "callSwitch.enabled",
        {
          "key": "callSwitch.hours",
          "condition": {
            "functionBody": "return !!model.callSwitch && model.callSwitch.enabled === true;"
          }
        }
      ]
    },
    {
      "type": "fieldset",
      "title": "Working switch",
      "items": [
        "workingSwitch.enabled"
      ]
    },
    {
      "type": "fieldset",
      "title": "Colors",
      "description": "A color such as #FF0000, or the word off to turn the light off for that status.",
      "items": [
        "colors.outOfOffice",
        "colors.doNotDisturb",
        "colors.inCall",
        "colors.inMeeting",
        "colors.busy",
        "colors.tentative",
        "colors.away",
        "colors.available",
        "colors.offline",
        "meetingWarningSeconds"
      ]
    },
    {
      "type": "fieldset",
      "title": "LIFX bulbs",
      "items": [
        "lifx.enabled",
        {
          "key": "lifx.bulbs",
          "condition": {
            "functionBody": "return model.lifx && model.lifx.enabled === true;"
          }
        },
        {
          "key": "lifx.host",
          "condition": {
            "functionBody": "return model.lifx && model.lifx.enabled === true;"
          }
        },
        {
          "key": "lifx.brightness",
          "condition": {
            "functionBody": "return model.lifx && model.lifx.enabled === true;"
          }
        },
        {
          "key": "lifx.refreshSeconds",
          "condition": {
            "functionBody": "return model.lifx && model.lifx.enabled === true;"
          }
        }
      ]
    },
    {
      "key": "sensors",
      "type": "checkboxes",
      "titleMap": [
        {
          "value": "available",
          "name": "Available"
        },
        {
          "value": "busyAny",
          "name": "Busy"
        },
        {
          "value": "outOfOffice",
          "name": "Out of Office"
        },
        {
          "value": "inMeeting",
          "name": "In a Meeting"
        },
        {
          "value": "inCall",
          "name": "In a Call"
        },
        {
          "value": "doNotDisturb",
          "name": "Do Not Disturb"
        },
        {
          "value": "busy",
          "name": "Busy in Teams"
        },
        {
          "value": "tentative",
          "name": "Tentative"
        },
        {
          "value": "away",
          "name": "Away"
        },
        {
          "value": "offline",
          "name": "Offline"
        },
        {
          "value": "meetingSoon",
          "name": "Meeting Soon"
        }
      ]
    },
    "overrideSwitch",
    "pollSeconds",
    "calendarSeconds",
    "ignoreAllDayBusy",
    {
      "key": "outOfOfficeWords",
      "type": "array",
      "items": [
        "outOfOfficeWords[]"
      ],
      "orderable": false
    },
    "debug"
  ]
}
