{
  "pluginAlias": "M365Status",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Shows whether you are available, in a meeting, or out of office, on a LIFX bulb and as HomeKit sensors. Turn on only the sources you use. See the README for how to get each credential.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "My Status",
        "description": "Used as the start of each sensor's name, for example \"My Status In a Meeting\"."
      },
      "icloud": {
        "title": "iCloud Calendar",
        "type": "object",
        "properties": {
          "enabled": { "title": "Use iCloud Calendar", "type": "boolean", "default": false },
          "appleId": { "title": "Apple ID email", "type": "string", "format": "email" },
          "appPassword": {
            "title": "App-specific password",
            "type": "string",
            "description": "Created at account.apple.com under Sign-In and Security. This is not your Apple ID password."
          },
          "calendars": {
            "title": "Calendars to include",
            "type": "array",
            "items": { "title": "Calendar name", "type": "string" },
            "description": "Leave empty to use every calendar. The log lists the calendar names found."
          }
        }
      },
      "google": {
        "title": "Google Calendar",
        "type": "object",
        "properties": {
          "enabled": { "title": "Use Google Calendar", "type": "boolean", "default": false },
          "icalUrls": {
            "title": "Secret iCal addresses",
            "type": "array",
            "items": { "title": "Secret address in iCal format", "type": "string" },
            "description": "In Google Calendar: Settings, pick the calendar, Integrate calendar, \"Secret address in iCal format\". One per calendar."
          },
          "email": {
            "title": "Your Google email",
            "type": "string",
            "description": "Optional. Lets the plugin ignore invitations you declined."
          }
        }
      },
      "microsoft": {
        "title": "Microsoft 365",
        "type": "object",
        "properties": {
          "enabled": { "title": "Use Microsoft 365", "type": "boolean", "default": false },
          "tenantId": { "title": "Directory (tenant) ID", "type": "string" },
          "clientId": { "title": "Application (client) ID", "type": "string" },
          "presence": { "title": "Use Teams presence", "type": "boolean", "default": true },
          "calendar": { "title": "Use Outlook calendar", "type": "boolean", "default": true }
        }
      },
      "lifx": {
        "title": "LIFX bulb",
        "type": "object",
        "properties": {
          "enabled": { "title": "Set a LIFX bulb directly", "type": "boolean", "default": false },
          "host": {
            "title": "Bulb IP address",
            "type": "string",
            "placeholder": "192.168.4.50",
            "description": "Give the bulb a fixed IP address in your router so this does not change."
          },
          "brightness": { "title": "Brightness (%)", "type": "integer", "default": 100, "minimum": 1, "maximum": 100 },
          "refreshSeconds": {
            "title": "Resend the color every (seconds)",
            "type": "integer",
            "default": 0,
            "minimum": 0,
            "description": "0 sends only when the status changes. Set to 60 or more if the bulb is sometimes switched off at the wall."
          }
        }
      },
      "colors": {
        "title": "Colors",
        "type": "object",
        "description": "A hex color such as #FF0000, or the word off to turn the bulb off for that status.",
        "properties": {
          "available": { "title": "Available", "type": "string", "default": "#00FF00" },
          "inMeeting": { "title": "In a Meeting", "type": "string", "default": "#FF0000" },
          "inCall": { "title": "In a Call", "type": "string", "default": "#FF0000" },
          "doNotDisturb": { "title": "Do Not Disturb", "type": "string", "default": "#FF0000" },
          "busy": { "title": "Busy", "type": "string", "default": "#FF6A00" },
          "tentative": { "title": "Tentative", "type": "string", "default": "#FFD000" },
          "away": { "title": "Away", "type": "string", "default": "#FFD000" },
          "outOfOffice": { "title": "Out of Office", "type": "string", "default": "#B400FF" },
          "offline": { "title": "Offline", "type": "string", "default": "off" }
        }
      },
      "sensors": {
        "title": "HomeKit sensors to create",
        "type": "array",
        "uniqueItems": true,
        "default": ["available", "inMeeting", "inCall", "doNotDisturb", "busy", "outOfOffice"],
        "items": {
          "type": "string",
          "enum": ["available", "inMeeting", "inCall", "doNotDisturb", "busy", "tentative", "away", "outOfOffice", "offline"]
        },
        "description": "Each one is an occupancy sensor that is on while that is your status."
      },
      "outOfOfficeKeywords": {
        "title": "Out of office words",
        "type": "array",
        "items": { "type": "string" },
        "default": ["Out of office", "OOO", "Vacation", "PTO"],
        "description": "iCloud and Google events whose title contains one of these count as out of office."
      },
      "ignoreAllDayBusy": {
        "title": "Ignore all-day events marked busy",
        "type": "boolean",
        "default": true,
        "description": "All-day out of office events always count."
      },
      "pollSeconds": { "title": "Check status every (seconds)", "type": "integer", "default": 30, "minimum": 15 },
      "calendarSeconds": { "title": "Reload calendars every (seconds)", "type": "integer", "default": 180, "minimum": 60 }
    }
  }
}
