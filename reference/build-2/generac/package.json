{
  "name": "homebridge-generac",
  "displayName": "Generac",
  "type": "module",
  "version": "1.0.1",
  "description": "Generac Mobile Link standby generators in HomeKit: running, fault and maintenance sensors plus starting-battery health.",
  "author": "Alex Rodriguez (https://alex-rodriguez.com)",
  "license": "Apache-2.0",
  "homepage": "https://github.com/arodbuilds/homebridge-generac#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/arodbuilds/homebridge-generac.git"
  },
  "bugs": {
    "url": "https://github.com/arodbuilds/homebridge-generac/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "generac",
    "mobilelink",
    "mobile link",
    "generator",
    "standby generator",
    "homekit"
  ],
  "main": "dist/index.js",
  "bin": {
    "homebridge-generac": "dist/cli.js"
  },
  "files": [
    "dist",
    "homebridge-ui/public",
    "homebridge-ui/server.js",
    "config.schema.json",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": "^20.18.0 || ^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc && npm run build:ui",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "npm run lint && npm run build",
    "test": "npm run lint && npm run build && npm run test:unit",
    "test:unit": "rimraf ./build-test && tsc -p tsconfig.test.json && node --test build-test/test/*.test.js",
    "watch": "npm run build && npm link && nodemon",
    "build:ui": "rimraf ./homebridge-ui/public/js && tsc -p homebridge-ui && node scripts/build-ui.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@homebridge/hap-nodejs": "^2.2.3",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "homebridge": "^2.4.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.6"
  }
}
