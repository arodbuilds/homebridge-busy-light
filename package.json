{
  "name": "homebridge-busy-light",
  "displayName": "Busy Light",
  "type": "module",
  "version": "1.0.0",
  "description": "Shows your calendar and Teams status on a light: green when you are free, red when you are not. iCloud, Google Calendar, Microsoft 365 and calendar URLs, with LIFX control and HomeKit sensors.",
  "author": "Alex Rodriguez (https://alex-rodriguez.com)",
  "license": "Apache-2.0",
  "homepage": "https://github.com/arodbuilds/homebridge-busy-light#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arodbuilds/homebridge-busy-light.git"
  },
  "bugs": {
    "url": "https://github.com/arodbuilds/homebridge-busy-light/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "busy light",
    "busylight",
    "status light",
    "calendar",
    "icloud",
    "google calendar",
    "microsoft 365",
    "teams",
    "presence",
    "lifx",
    "homekit"
  ],
  "main": "dist/index.js",
  "bin": {
    "homebridge-busy-light": "dist/cli.js"
  },
  "files": [
    "dist",
    "homebridge-ui/public",
    "homebridge-ui/server.js",
    "config.schema.json",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": "^20.18.0 || ^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc && npm run build:ui",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "npm run lint && npm run build",
    "test": "npm run lint && npm run build && npm run test:unit",
    "test:unit": "rimraf ./build-test && tsc -p tsconfig.test.json && node --test build-test/test/*.test.js",
    "watch": "npm run build && npm link && nodemon",
    "build:ui": "rimraf ./homebridge-ui/public/js && tsc -p homebridge-ui && node scripts/build-ui.mjs",
    "test:layout": "node test/layout/layout-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@homebridge/hap-nodejs": "^2.2.3",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "homebridge": "^2.4.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.6",
    "ical.js": "^2.2.1"
  }
}
